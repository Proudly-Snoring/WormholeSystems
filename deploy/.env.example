# Configuration for the deploy/docker-compose.yml stack — Proudly Snoring's own instance
# at https://mapper.prsn.online.
#
# Run `deploy/generate-env.sh` to turn this into `deploy/.env` with the secrets filled in,
# then complete the keys it lists as still missing.
#
# Everything here takes effect when a container starts. Two classes of value are deliberately
# absent because this file is not where they are safe to change:
# - Frozen when the image is *built* — the application name, the websocket settings, and the
#   public domain the browser uses — declared in .github/workflows/publish.yml instead.
# - Fixed by the shape of this compose stack — service names/ports, and anything built from
#   CONTACT_EMAIL below — declared in docker-compose.yml instead.
#
# /!\ Values here are loaded verbatim into each container via `env_file:` — no ${VAR}
# /!\ interpolation happens inside this file itself (ex: `FOO="${BAR}/x"` sets FOO to the
# /!\ literal string `${BAR}/x`).

# ---------------------------------------------------------------------------
# Generated — `deploy/generate-env.sh` fills these in
# ---------------------------------------------------------------------------

# The symmetric secret Laravel uses for encryption and signing (ex: cookies).
# Rotating it logs everyone out and makes existing encrypted column values unreadable.
APP_KEY=

# Also used as the database root password by docker-compose.yml.
DB_PASSWORD=

# The Reverb application identity.
# Set strong random strings.
REVERB_APP_ID=
REVERB_APP_SECRET=

# Encrypts the database backups made by the `backup` service, cf. the "Backups" section of
# deploy/readme.md. Needed to decrypt them too, so keep it somewhere durable.
BACKUP_ENCRYPTION_PASSPHRASE=

# ---------------------------------------------------------------------------
# Must be filled in by hand
# ---------------------------------------------------------------------------

# Required by the EVE API — an instance it cannot contact risks a ban.
# Also used for the Caddy ACME contact.
CONTACT_EMAIL=

# From the EVE developer portal, cf. the "EVE application setup" section of the main readme.
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# This instance
# ---------------------------------------------------------------------------

APP_NAME=WormholeSystems
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=info

# APP_URL, SERVER_NAME, EVE_CALLBACK, DISCORD_CALLBACK and SESSION_SECURE_COOKIE are
# deliberately absent: they are frozen into the image at build time (the certificate Caddy
# requests and the websocket target are already fixed to this domain via VITE_REVERB_*), so a
# differing value here would always be a misconfiguration, never a working alternate domain.
#
# Do not add them below either: env_file values take precedence over the image's own ENV, so
# setting them here would silently override the baked value rather than being ignored.
# Self-hosters on another domain build their own image instead —
# cf. .github/workflows/publish.yml and deploy/architecture.md.
#
# DB_HOST, REVERB_HOST and the rest of this stack's topology are likewise absent: they are
# fixed in docker-compose.yml's `environment:` block instead, because they name the other
# services in that same file and moving one without the other just breaks the stack.

# ---------------------------------------------------------------------------
# Optional features — leave empty to switch off
# ---------------------------------------------------------------------------

# Restrict who may log in, by EVE character/corporation/alliance ID, comma separated.
ALLOWED_AFFILIATION_IDS=

# Discord account linking and the bot process, cf. the main readme.
# The bot itself is the `discord` service, behind the `discord` compose profile: it stays stopped
# unless started explicitly, so filling these in alone gives account linking but no slash commands
# — cf. the "Discord bot" section of deploy/readme.md.
DISCORD_APPLICATION_ID=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Invite link shown in the UI.
DISCORD_INVITE=

# Error reporting.
SENTRY_LARAVEL_DSN=
SENTRY_SEND_DEFAULT_PII=false
